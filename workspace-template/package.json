{
  "name": "epris-workspace-template",
  "version": "1.0.0",
  "description": "Minimal Remotion template for Epris workspace",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3030",
    "typecheck": "tsc --noEmit",
    "epris:validate": "node src/epris/validate-contract.mjs",
    "smoke:0": "pnpm exec remotion still src/Root.tsx Main .epris/tmp/smoke-0.png --frame=0",
    "smoke:mid": "pnpm exec remotion still src/Root.tsx Main .epris/tmp/smoke-mid.png --frame=75",
    "export": "pnpm exec remotion render src/Root.tsx Main out/video.mp4 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "@remotion/player": "4.0.409",
    "@remotion/renderer": "4.0.409",
    "@remotion/media-utils": "4.0.409",
    "bezier-easing": "^2.1.0",
    "culori": "^4.0.2",
    "d3-array": "^3.2.4",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "flubber": "^0.4.2",
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-katex": "^3.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.409",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "svg-path-properties": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  }
}
